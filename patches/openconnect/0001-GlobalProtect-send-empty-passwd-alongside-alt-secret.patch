From 34b78fb86cf934b6009ad7b1b4f312faf35e6319 Mon Sep 17 00:00:00 2001
From: Azizbek Atajanov <33376229+azizbekatajanov@users.noreply.github.com>
Date: Tue, 11 Aug 2026 12:05:19 +0500
Subject: [PATCH] GlobalProtect: send empty "passwd" alongside alt-secret field

When an alternate secret field (e.g. a SAML/prelogin cookie via
--usergroup=gateway:prelogin-cookie) is used instead of a real
password, the form option carrying it is named after that alt-secret
field rather than "passwd", so append_form_opts() never emits a
"passwd" field in the login.esp/getconfig.esp POST body at all.

Some GlobalProtect gateways require "passwd" to be physically present
in the request (even empty) alongside the alt-secret field, and
reject requests missing it entirely with HTTP 512
auth-failed-password-empty.

Send an empty "passwd" whenever an alt-secret is in use, alongside
the alt-secret field, to satisfy such gateways. This does not affect
ordinary password-based logins, where no alt-secret is set.

Closes #859
---
 auth-globalprotect.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/auth-globalprotect.c b/auth-globalprotect.c
index 8d094273..046e8849 100644
--- a/auth-globalprotect.c
+++ b/auth-globalprotect.c
@@ -752,6 +752,15 @@ static int gpst_login(struct openconnect_info *vpninfo, int portal, struct login
 			append_opt(request_body, "preferred-ipv6", vpninfo->ip_info.addr);
 		if (ctx->form->action)
 			append_opt(request_body, "inputStr", ctx->form->action);
+		/* When an alternate secret field (e.g. a SAML/prelogin cookie) is used
+		 * instead of a real password, the form option's name is that alt-secret
+		 * field name (see new_auth_form()), so the ordinary "passwd" field is
+		 * never emitted by append_form_opts() below. Some gateways reject
+		 * login.esp/getconfig.esp requests missing "passwd" entirely with
+		 * HTTP 512 auth-failed-password-empty, so send it empty alongside the
+		 * alt-secret field. */
+		if (ctx->alt_secret)
+			append_opt(request_body, "passwd", "");
 		append_form_opts(vpninfo, ctx->form, request_body);
 		if ((result = buf_error(request_body)))
 			goto out;
