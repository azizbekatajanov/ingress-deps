From 104ce93edb07b43b392699a7756fda8beb80a5a8 Mon Sep 17 00:00:00 2001
From: Azizbek Atajanov <33376229+azizbekatajanov@users.noreply.github.com>
Date: Tue, 10 Nov 2026 14:09:06 +0500
Subject: [PATCH 1/2] Read the password from stdin with --password -

Without the pppd plugin sstpc needs --user and --password on its
command line, where every local user can read the password in the
process list. '--password -' reads it from the first line of stdin
instead.
---
 src/sstp-option.c | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/src/sstp-option.c b/src/sstp-option.c
index 1f6a241..70d09d3 100644
--- a/src/sstp-option.c
+++ b/src/sstp-option.c
@@ -72,7 +72,7 @@ void sstp_usage_die(const char *prog, int code,
     printf("  --ipparam <param>        The unique connection id used w/pppd\n");
     printf("  --help                   Display this menu\n");
     printf("  --nolaunchpppd           Don't start pppd, for use with pty option\n");
-    printf("  --password               Password\n");
+    printf("  --password               Password (\"-\": read it from stdin)\n");
     printf("  --priv-user              The user to run as\n");
     printf("  --priv-group             The group to run as\n");
     printf("  --priv-dir               The privilege separation directory\n");
@@ -196,8 +196,26 @@ static void sstp_parse_option(sstp_option_st *ctx, int argc, char **argv, int in
         break;
 
     case 7: 
-        ctx->password = strdup(optarg);
-        sstp_scramble(optarg);
+        /* "--password -" reads the password from the first line of stdin,
+         * so it never appears in the process list */
+        if (!strcmp(optarg, "-"))
+        {
+            char line[256];
+            size_t len;
+            if (!fgets(line, sizeof(line), stdin))
+            {
+                sstp_die("Could not read the password from stdin", -1);
+            }
+            len = strcspn(line, "\r\n");
+            line[len] = '\0';
+            ctx->password = strdup(line);
+            memset(line, 0, sizeof(line));
+        }
+        else
+        {
+            ctx->password = strdup(optarg);
+            sstp_scramble(optarg);
+        }
         break;
 
     case 8:
-- 
